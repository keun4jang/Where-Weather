# Where Weather environment variables (all optional — app works with zero config)

# Optional: a proxy endpoint for MET Norway requests (their API requires a
# User-Agent header which browsers cannot set). If unset, the app falls back to
# Open-Meteo only. See functions/api/metno.ts for a Cloudflare Pages function.
VITE_METNO_PROXY_URL=

# Optional: contact string used as the User-Agent for MET Norway (server-side).
METNO_USER_AGENT=where-weather/0.1.0 contact@example.com

# Optional: Formspree form ID for in-app feedback (https://formspree.io).
# Create a free account, add your email, and paste the form ID here.
VITE_FORMSPREE_ID=
