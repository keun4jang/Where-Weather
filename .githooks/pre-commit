#!/usr/bin/env sh
# Where Weather pre-commit hook: keep generated version in sync and run fast checks.
set -e

echo "[pre-commit] bumping patch version…"
node scripts/bump-version.mjs patch >/dev/null
git add package.json src/generated/appVersion.ts public/version.json 2>/dev/null || true

echo "[pre-commit] typecheck…"
npm run --silent typecheck

echo "[pre-commit] lint…"
npm run --silent lint

echo "[pre-commit] tests…"
npm run --silent test

echo "[pre-commit] OK"
